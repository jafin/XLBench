<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>XLBench</AssemblyName>
    <RootNamespace>XLBench</RootNamespace>
    <!-- BenchmarkDotNet must build in Release to produce trustworthy numbers. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <AcceptNPOIOSMFLicense>true</AcceptNPOIOSMFLicense>
  </PropertyGroup>

  <!-- Source datasets for the report and edit scenarios. Embedded (not copied) so they resolve
       regardless of the working directory BenchmarkDotNet gives its generated child processes. -->
  <ItemGroup>
    <EmbeddedResource Include="Data\stock_data.json" LogicalName="XLBench.Data.stock_data.json" />
    <EmbeddedResource Include="Data\numbers.csv" LogicalName="XLBench.Data.numbers.csv" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="IronXL.Excel" Version="2026.8.1" />
    <!-- Transitive pin: overrides a vulnerable 10.0.7 pulled in by the Excel libraries. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.11" />
  </ItemGroup>

  <!-- Excel libraries under test — all referenced via NuGet only. -->
  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="EPPlus" Version="8.7.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="NPOI" Version="2.8.0" />
    <PackageReference Include="MiniExcel" Version="1.46.0" />
    <!-- XLibur meta-package. Pulls in XLibur + XLibur.Fonts.SkiaSharp.
         The font engine auto-registers on first use; no bootstrap call required. -->
    <PackageReference Include="XLibur.Bundle" Version="0.311.1" />
  </ItemGroup>

</Project>
