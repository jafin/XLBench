<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>XLBench</AssemblyName>
    <RootNamespace>XLBench</RootNamespace>
    <!-- BenchmarkDotNet must build in Release to produce trustworthy numbers. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <!-- Transitive pin: overrides a vulnerable 10.0.7 pulled in by the Excel libraries. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10" />
  </ItemGroup>

  <!-- Excel libraries under test — all referenced via NuGet only. -->
  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="EPPlus" Version="8.6.2" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="NPOI" Version="2.8.0" />
    <PackageReference Include="MiniExcel" Version="1.45.0" />
    <!-- XLibur meta-package (prerelease). Pulls in XLibur + XLibur.Fonts.SkiaSharp.
         The font engine auto-registers on first use; no bootstrap call required. -->
    <PackageReference Include="XLibur.Bundle" Version="0.105.1-rc.137" />
  </ItemGroup>

</Project>
